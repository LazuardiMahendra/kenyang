<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_comment_profile"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_margin="7.5dp"
        android:src="@drawable/ic_account"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_comment_profile_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="7.5dp"
        android:text="User ID"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/iv_comment_profile" />

    <TextView
        android:id="@+id/tv_comment_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="7.5dp"
        android:text="Message"
        app:layout_constraintStart_toEndOf="@+id/iv_comment_profile"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_profile_id" />
</androidx.constraintlayout.widget.ConstraintLayout>